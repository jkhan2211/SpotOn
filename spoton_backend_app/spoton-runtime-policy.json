{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SpotOnDynamoDBData",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:209479307795:table/spoton-residents",
        "arn:aws:dynamodb:us-east-1:209479307795:table/spoton-vehicles",
        "arn:aws:dynamodb:us-east-1:209479307795:table/spoton-spaces",
        "arn:aws:dynamodb:us-east-1:209479307795:table/spoton-permits",
        "arn:aws:dynamodb:us-east-1:209479307795:table/spoton-waitlist",
        "arn:aws:dynamodb:us-east-1:209479307795:table/spoton-vehicle-reports"
      ]
    },
    {
      "Sid": "SpotOnSESSend",
      "Effect": "Allow",
      "Action": ["ses:SendEmail"],
      "Resource": ["arn:aws:ses:us-east-1:209479307795:identity/mjunaidtestlabaws01@gmail.com"]
    },
    {
      "Sid": "SpotOnBedrockModel",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": [
        "arn:aws:bedrock:us-east-1:209479307795:inference-profile/global.anthropic.claude-sonnet-4-6",
        "arn:aws:bedrock:::foundation-model/anthropic.claude-sonnet-4-6",
        "arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-sonnet-4-6"
      ]
    }
  ]
}
