# AWS credentials profile (must match a profile in ~/.aws/credentials)
AWS_PROFILE=spoton

# AWS region for SES and DynamoDB
AWS_REGION=us-east-1

# SES verified sender email
SPOTON_SES_FROM_EMAIL=your-verified-email@example.com

# Email address to receive booking confirmations
SPOTON_RECIPIENT_EMAIL=your-email@example.com

# Persistence backend: "csv" (default, file-based) or "dynamodb" (AWS-backed,
# uses AWS_PROFILE/AWS_REGION above).
SPOTON_DATA_BACKEND=csv

# DynamoDB table names — only read when SPOTON_DATA_BACKEND=dynamodb.
SPOTON_RESIDENTS_TABLE=spoton-residents
SPOTON_VEHICLES_TABLE=spoton-vehicles
SPOTON_SPACES_TABLE=spoton-spaces
SPOTON_PERMITS_TABLE=spoton-permits
SPOTON_WAITLIST_TABLE=spoton-waitlist
SPOTON_VEHICLE_REPORTS_TABLE=spoton-vehicle-reports
